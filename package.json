  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "vitest": "3.2.7",
    "@playwright/test": "1.56.1",
    "turbo": "2.6.1",
